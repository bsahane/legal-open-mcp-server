# MCP Server Configuration
MCP_HOST=localhost
MCP_PORT=5001
MCP_TRANSPORT_PROTOCOL=http
# MCP_SSL_KEYFILE=/path/to/ssl_key.pem
# MCP_SSL_CERTFILE=/path/to/ssl_cert.pem

ENABLE_AUTH=False
USE_EXTERNAL_BROWSER_AUTH=False

# Set this to True if you need to plug it into cursor
COMPATIBLE_WITH_CURSOR=True

# Python Logging
PYTHON_LOG_LEVEL=INFO

# This is required only if ENABLE_AUTH is True
SSO_CLIENT_ID=sso_client_id
SSO_CLIENT_SECRET=sso_client_secret
SSO_ISSUER_HOST=sso_issuer_host
SSO_CALLBACK_URL=http://localhost:8080/auth/callback/oidc
SSO_SCOPES=email,openid,profile,session:role-any
# Get these from your provider's .well-known/openid-configuration endpoint
SSO_AUTHORIZATION_URL=https://sso.example.com/realms/myrealm/protocol/openid-connect/auth
SSO_TOKEN_URL=https://sso.example.com/realms/myrealm/protocol/openid-connect/token
# rfc7662 = POST introspection (Keycloak, Auth0, Okta). tokeninfo = GET ?access_token= (Google)
SSO_INTROSPECTION_MODE=rfc7662
# For Google OAuth use tokeninfo mode instead:
# SSO_INTROSPECTION_MODE=tokeninfo
# SSO_INTROSPECTION_URL=https://oauth2.googleapis.com/tokeninfo
SSO_INTROSPECTION_URL=https://sso.example.com/realms/myrealm/protocol/openid-connect/token/introspect

# --- PostgreSQL (required only if ENABLE_AUTH=True, for token storage) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

# =====================================================================
# Legal MCP Server
# =====================================================================

# --- Jurisdiction defaults ---
DEFAULT_JURISDICTION=IN
DEFAULT_STATE=Maharashtra
DEFAULT_HIGH_COURT=Bombay

# --- Bundled data ---
# Build the corpus first:
#   python scripts/build_seed_acts.py && python scripts/fetch_corpus.py
LEGAL_DATA_PATH=./data
DOCUMENT_STORAGE_PATH=./data/documents

# --- Case law (Indian Kanoon) ---
# Get a token at https://api.indiankanoon.org/ - Rs 500 free credit on signup.
# Without a token, case-law tools report "unavailable" rather than guessing.
INDIAN_KANOON_API_KEY=
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org
# Hard daily spend cap in INR. Search Rs 0.50, judgment Rs 0.20, passage Rs 0.05.
# Set 0 to disable all paid calls.
INDIAN_KANOON_DAILY_BUDGET_INR=100

# --- Citation verification ---
# When True, citations in memos and drafts are resolved against a real source
# and marked UNVERIFIED when they cannot be confirmed. Leave this on.
ENABLE_CITATION_VERIFICATION=True

# --- Court case status ---
# manual  : returns eCourts portal URLs and steps for you to follow (default).
#           The official portal is CAPTCHA-gated and is never automated here.
# api     : uses a licensed third-party provider (needs ECOURTS_API_KEY).
# disabled: court status tools are switched off.
ECOURTS_ADAPTER=manual
ECOURTS_API_KEY=
ECOURTS_API_BASE_URL=https://api.ecourtsindia.com/v1

# --- Document search embeddings ---
# voyage  : voyage-law-2, a legal-domain model (needs VOYAGE_API_KEY,
#           install with: uv pip install -e ".[voyage]")
# local   : fastembed, fully offline, no key
#           (install with: uv pip install -e ".[local]")
# disabled: Postgres full-text search only
EMBEDDING_PROVIDER=disabled
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-law-2
EMBEDDING_DIMENSIONS=1024
